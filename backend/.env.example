# =====================================================================
# Variables de entorno del BACKEND (Supabase Edge Functions). NUNCA en el cliente del juego.
# Copia a .env (no se sube a git) para `supabase functions serve --env-file backend/.env`
# y en la nube: `supabase secrets set --env-file backend/.env` (o desde el panel de Supabase).
# Un entorno por proyecto de Supabase: DEV, STAGING y PRODUCTION nunca comparten claves.
# =====================================================================

# --- Entorno ---
APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:5173       # dominio del juego web (CORS y success/cancel URL)
ADMIN_URL=                          # dónde abres el panel admin (CORS), p. ej. http://localhost:8080

# --- Supabase (las rellena Supabase automáticamente en las Edge Functions desplegadas) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # o SUPABASE_PUBLISHABLE_KEY (sb_publishable_…): pública
SUPABASE_SERVICE_ROLE_KEY=          # SECRETA (sb_secret_… / service_role): solo servidor
SUPABASE_DB_URL=                    # SECRETA: conexión Postgres para transacciones

# --- Stripe (TEST hasta «ACTIVAR PRODUCCIÓN») ---
STRIPE_SECRET_KEY=sk_test_...       # SECRETA. Una clave sk_live_ fuera de producción se rechaza
STRIPE_WEBHOOK_SECRET=whsec_...     # SECRETA. La da Stripe al crear el endpoint del webhook
STRIPE_PUBLISHABLE_KEY=pk_test_...  # pública (no se usa con Checkout alojado; para futuros Elements)
STRIPE_API_VERSION=2026-09-30.endive
# STRIPE_API_BASE=http://localhost:12111/v1   # solo pruebas locales con stripe-mock; ignorado en producción

# --- Apple (desactivado hasta appleBillingEnabled = true) ---
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=                  # SECRETA: contenido del .p8 de la App Store Server API
APPLE_BUNDLE_ID=com.delbarrio.app
APPLE_APP_ID=                       # Apple ID numérico de la app (obligatorio en producción)
APPLE_ENV=Sandbox                   # Sandbox | Production
APPLE_ROOT_CERTS_B64=               # certificados raíz de Apple (DER en base64, separados por comas)

# --- Google Play (desactivado hasta googleBillingEnabled = true) ---
GOOGLE_PACKAGE_NAME=com.delbarrio.app
GOOGLE_SERVICE_ACCOUNT_JSON=        # SECRETA: JSON de la cuenta de servicio con acceso a Play Console
GOOGLE_PUBSUB_SHARED_TOKEN=         # SECRETA: token de la suscripción push de RTDN
